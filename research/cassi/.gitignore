# CASSI-local ignores (paper_plan_v2 §16/§19)

# P0: pinned upstream clones — never committed; their commit hashes are recorded
# in configs/cassi.yaml `pins:` at install time (§19: clone, pin, never modify).
third_party/

# P1: datasets, retrieval indices, corpora (regenerated by scripts/p1_data.sh;
# counts + split hashes live in the committed data manifest copy under experiments/results/)
data/

# Experiment outputs (trajectories, checkpoints, wandb runs, logs) are NOT committed —
# EXCEPT the results CSVs that figures/tables regenerate from (§16 P9 done-criterion).
experiments/*
!experiments/results/
experiments/results/*
!experiments/results/*.csv
!experiments/results/.gitkeep

wandb/

# python
__pycache__/
*.pyc
*.egg-info/

# paper build artifacts (P11: latexmk). Scoped to paper/ on purpose:
# a bare "*.log" would swallow GO_NO_GO.log, which MUST stay committed (§5.6).
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf
paper/sections/*.aux
paper/figures/*.pdf
paper/tables/*.tex
