__pycache__/
*.pyc
*.egg-info/
.remember/
.claude/scheduled_tasks.lock
*.bak
.venv/
venv/
.opencode/

# experiment outputs — regenerated by the harness (runs/ = per-run traces,
# results/ = latest-run convenience copies). Kept on disk, out of git: they grow
# unbounded and are reproducible from the committed harness + dataset.
# Exception: analysis.txt is the committed stats snapshot RESULTS.md cites.
experiments/hotpotqa/runs/
experiments/hotpotqa/results/*
!experiments/hotpotqa/results/analysis.txt

.claude/settings.json

# contaminated pre-integrity-fix runs, kept local for provenance
experiments/hotpotqa/_prelim_archive/

# real-CC adapter experiment: per-run traces (regenerable) + the runtime-generated
# hook settings file. results/run_summaries.json IS committed (the snapshot).
experiments/cc_adapter/runs/
experiments/cc_adapter/.hooks_settings.json

# real-CLI experiment: per-run traces (events/transcripts/hook logs/daemon dumps,
# regenerable). data/, budgets.json, analysis.json and RESULTS.md ARE committed.
experiments/real_cli/runs/
experiments/real_cli/daemon_sweep.out

# e2e feature-verification: per-run traces incl. persistent sandbox projects
# (regenerable). verify.json snapshot of the reported run IS copied into
# RESULTS.md; raw runs stay local.
experiments/e2e_verify/runs/
experiments/real_cli/sweep_all.log

.pytest_cache/
